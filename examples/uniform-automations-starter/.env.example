# Copy to .env and fill in. The Uniform CLI loads .env automatically.
#
# The API key needs Developer (to push Canvas data) and Manage Automations
# (to deploy automations). At deploy time you can only grant roles you hold.

UNIFORM_API_KEY=
UNIFORM_PROJECT_ID=
UNIFORM_PREVIEW_SECRET=hello-world

# Optional: point at a non-prod stack.
# UNIFORM_CLI_BASE_URL=https://uniform.app

# ---------------------------------------------------------------------------
# Secrets for the automations themselves.
#
# Only variables named UNIFORM_ENV_* are inlined into the deployed bundle, and
# only when read as a literal (`process.env.UNIFORM_ENV_FOO`) — a computed
# lookup is not inlined and reads as undefined at runtime.
#
# Set only the ones the automations you actually deploy need.
# ---------------------------------------------------------------------------

# daily-cleanup (deliberately fails until this is set — that's the point of the example)
UNIFORM_ENV_EXTERNAL_KEY=

# Slack incoming webhook — notifications, ai-workflow-notify
UNIFORM_ENV_SLACK_WEBHOOK_URL=

# Fallback in-product notification recipients (comma-separated identity subject IDs)
# Used when the run has no person behind it (schedule, webhook, API-key initiator)
UNIFORM_ENV_NOTIFY_RECIPIENTS=

# shared-content-sync — comma-separated target (spoke) project IDs
UNIFORM_ENV_SHARED_CONTENT_TARGETS=
