{
  "name": "@uniformdev/sveltekit-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "app:dev": "vite dev",
    "dev": "npm run pull:manifest && npm run app:dev",
    "build": "npm run pull:manifest && npm run app:build",
    "app:build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pull:manifest": "uniform context manifest download --output ./src/lib/uniform/contextManifest.json",
    "pull:content": "uniform sync pull",
    "push:content": "uniform sync push"
  },
  "dependencies": {
    "@uniformdev/canvas": "20.89.0",
    "@uniformdev/canvas-svelte": "20.89.0",
    "@uniformdev/canvas-sveltekit": "20.89.0",
    "@uniformdev/context": "20.89.0",
    "@uniformdev/context-edge": "20.89.0",
    "@uniformdev/context-edge-sveltekit": "20.89.0",
    "@uniformdev/context-svelte": "20.89.0",
    "@vercel/functions": "^3.4.0",
    "cookie": "1.1.1",
    "immer": "10.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-vercel": "7.0.3",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^25.3.0",
    "@uniformdev/cli": "20.89.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
